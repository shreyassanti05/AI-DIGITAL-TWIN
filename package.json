{
  "name": "ai-surveillance-platform",
  "version": "1.0.0",
  "description": "AI-Powered Intelligent Surveillance & Threat Detection System",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && docker build -t ai-surveillance-backend .",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && pytest",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && next lint",
    "lint:backend": "cd backend && flake8 app/",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd frontend && prettier --write .",
    "format:backend": "cd backend && black app/",
    "typecheck": "cd frontend && tsc --noEmit",
    "db:migrate": "cd backend && alembic upgrade head",
    "db:reset": "cd backend && alembic downgrade base && alembic upgrade head",
    "seed": "cd backend && python scripts/seed_database.py",
    "ai:train": "cd ai-models && python training/train_all.py",
    "ai:download-weights": "cd ai-models && python scripts/download_weights.py",
    "setup": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "clean": "rimraf node_modules frontend/node_modules backend/__pycache__ && find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "k8s:deploy": "kubectl apply -f docker/k8s/",
    "k8s:delete": "kubectl delete -f docker/k8s/"
  },
  "keywords": [
    "ai",
    "surveillance",
    "threat-detection",
    "computer-vision",
    "yolo",
    "deep-learning",
    "real-time",
    "security",
    "monitoring",
    "smart-city"
  ],
  "author": "AI Surveillance Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rimraf": "^5.0.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "backend/**/*.py": [
      "black",
      "flake8"
    ]
  }
}
